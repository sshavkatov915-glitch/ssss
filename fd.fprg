    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="vaqt" type="Integer" array="False" size=""/>
            <declare name="pul" type="Integer" array="False" size=""/>
            <output expression="&quot;kompyuterda oynaga vaqtingiz&quot;" newline="True"/>
            <input variable="vaqt"/>
            <output expression="&quot;oynagan vaqtingiz uchun tolov&quot;" newline="True"/>
            <input variable="pul"/>
            <if expression="vaqt&gt;=60 and pul&gt;=8">
                <then>
                    <output expression="&quot;kompyuter klubimizga kelganingizdan xursandmiz Ko'rishguncha&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;afsuski sizning mablag'ingiz yetarli emas&quot;" newline="True"/>
                </else>
            </if>
        </body>
